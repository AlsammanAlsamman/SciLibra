#:kivy 2.1
#:import theme scilibra.gui.theme
#:import dp kivy.metrics.dp
#:import widgets scilibra.gui.widgets

# ---------------------------------------------------------------- basic widgets
# Buttons are pills (Material 3); `bg` is the fill colour, text colour follows it automatically.
<FlatButton@HoverButton>:
    bg: theme.BUTTON
    fg: theme.on(self.bg)
    radius: dp(100)
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    color: self.fg
    disabled_color: self.fg
    opacity: 0.45 if self.disabled else 1
    font_size: '14sp'
    size_hint_y: None
    height: dp(38)
    padding: dp(14), 0
    elevation: 0
    canvas.before:
        Color:
            rgba: theme.alpha(theme.SHADOW, theme.SHADOW[3] * self.elevation * (1.5 if self.hovered else 1)) if not self.disabled else (0, 0, 0, 0)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -dp(2)
            blur_radius: (dp(10) if self.hovered else dp(6)) if self.elevation else 0
            border_radius: [min(self.radius, self.height / 2)] * 4
        Color:
            rgba: theme.darker(self.bg, 0.10) if self.state == 'down' else (theme.hover(self.bg) if self.hovered else self.bg)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [min(self.radius, self.height / 2)]

<AccentButton@FlatButton>:
    bg: theme.ACCENT
    bold: True
    elevation: 1

<DangerButton@FlatButton>:
    bg: theme.DANGER_CONTAINER
    fg: theme.DANGER

# transparent button for the app bar (white text on the gradient)
<BarButton@FlatButton>:
    bg: 1, 1, 1, 0
    fg: theme.ON_BAR
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.28) if self.state == 'down' else ((1, 1, 1, 0.16) if self.hovered else (1, 1, 1, 0))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

# item of a drop-down menu
<MenuItem@FlatButton>:
    bg: theme.PANEL
    radius: dp(8)
    halign: 'left'
    height: dp(40)

<MenuSeparator@Widget>:
    size_hint_y: None
    height: dp(9)
    canvas:
        Color:
            rgba: theme.OUTLINE
        Rectangle:
            pos: self.x + dp(10), self.center_y
            size: self.width - dp(20), dp(1)

<TLabel@Label>:
    color: theme.TEXT
    font_size: '14sp'
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1]
    markup: True

<MutedLabel@TLabel>:
    color: theme.MUTED
    font_size: '13sp'

<SectionLabel@TLabel>:
    color: theme.ACCENT
    bold: True
    font_size: '15sp'

<FieldLabel@Label>:
    color: theme.MUTED
    font_size: '13sp'
    size_hint_x: None
    width: dp(96)
    text_size: self.size
    halign: 'right'
    valign: 'middle'
    padding: dp(8), 0

<DarkInput@RoundedInput>:
    background_normal: ''
    background_active: ''
    background_disabled_normal: ''
    background_color: 0, 0, 0, 0
    fill: theme.INPUT
    focus_color: theme.ACCENT
    foreground_color: theme.TEXT
    disabled_foreground_color: theme.MUTED
    cursor_color: theme.ACCENT
    cursor_width: dp(2)
    selection_color: theme.alpha(theme.ACCENT, 0.3)
    hint_text_color: theme.MUTED
    padding: dp(14), dp(10)
    font_size: '14sp'
    multiline: False
    write_tab: False
    size_hint_y: None
    height: dp(40)

# rounded search field (pill)
<SearchInput@DarkInput>:
    fill: theme.PANEL
    radius: dp(22)
    padding: dp(18), dp(11)
    height: dp(42)

# a card: rounded surface with a soft shadow
<Panel@BoxLayout>:
    canvas.before:
        Color:
            rgba: theme.SHADOW
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -dp(2)
            blur_radius: dp(14)
            border_radius: [dp(18)] * 4
        Color:
            rgba: theme.PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]

<DarkSpinner@HoverBehavior+Spinner>:
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    size_hint_y: None
    height: dp(38)
    font_size: '14sp'
    option_cls: 'DarkSpinnerOption'
    canvas.before:
        Color:
            rgba: theme.darker(theme.BUTTON, 0.08) if self.state == 'down' else (theme.hover(theme.BUTTON) if self.hovered else theme.BUTTON)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
    canvas.after:
        Color:
            rgba: theme.MUTED
        Triangle:
            points: self.right - dp(22), self.center_y + dp(2.5), self.right - dp(12), self.center_y + dp(2.5), self.right - dp(17), self.center_y - dp(3)

<DarkSpinnerOption@HoverBehavior+SpinnerOption>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: theme.TEXT
    height: dp(40)
    canvas.before:
        Color:
            rgba: theme.ROW_SELECTED if self.state == 'down' else (theme.ROW if self.hovered else theme.PANEL)
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(1)
            size: self.width - dp(8), self.height - dp(2)
            radius: [dp(8)]

# menus (DropDown and Spinner lists): floating rounded card
<DropDown>:
    canvas.before:
        Color:
            rgba: theme.SHADOW
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -dp(3)
            blur_radius: dp(16)
            border_radius: [dp(12)] * 4
        Color:
            rgba: theme.PANEL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<ScrollView>:
    bar_color: theme.alpha(theme.MUTED, 0.55)
    bar_inactive_color: theme.alpha(theme.MUTED, 0.25)

# checkbox drawn in the theme colours (Kivy's default images are made for dark backgrounds)
<CheckBox>:
    color: 0, 0, 0, 0
    canvas.after:
        Color:
            rgba: (theme.ACCENT if self.active else (0, 0, 0, 0)) if not self.disabled else theme.alpha(theme.MUTED, 0.4 if self.active else 0)
        RoundedRectangle:
            pos: int(self.center_x - dp(9)), int(self.center_y - dp(9))
            size: dp(18), dp(18)
            radius: [dp(9) if self.group else dp(4)]
        Color:
            rgba: (0, 0, 0, 0) if self.active else (theme.MUTED if not self.disabled else theme.alpha(theme.MUTED, 0.4))
        Line:
            rounded_rectangle: int(self.center_x - dp(9)), int(self.center_y - dp(9)), dp(18), dp(18), (dp(9) if self.group else dp(4))
            width: dp(1.3)
        Color:
            rgba: theme.on(theme.ACCENT) if self.active else (0, 0, 0, 0)
        Line:
            points: self.center_x - dp(4.5), self.center_y + dp(0.3), self.center_x - dp(1.2), self.center_y - dp(3.2), self.center_x + dp(4.8), self.center_y + dp(3.4)
            width: dp(1.6)
            cap: 'round'
            joint: 'round'

# progress bar: rounded track with an accent fill
<ThemedProgress@Widget>:
    max: 100
    value: 0
    size_hint_y: None
    height: dp(8)
    canvas:
        Color:
            rgba: theme.ACCENT_CONTAINER
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: theme.ACCENT
        RoundedRectangle:
            pos: self.pos
            size: (self.width * min(1, self.value / float(self.max)) if self.max else 0), self.height
            radius: [self.height / 2]

# ---------------------------------------------------------------- library list row
<ListRow>:
    orientation: 'horizontal'
    padding: dp(10), dp(6), dp(12), dp(6)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: theme.ROW_SELECTED if self.selected else (theme.darker(theme.ROW_GROUP if self.kind == 'group' else theme.ROW, 0.05) if self.state == 'down' else (theme.hover(theme.ROW_GROUP if self.kind == 'group' else theme.ROW) if self.hovered else (theme.ROW_GROUP if self.kind == 'group' else theme.ROW)))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: theme.ACCENT if self.selected else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.y + dp(12)
            size: dp(4), max(0, self.height - dp(24))
            radius: [dp(2)]
    # leading avatar: first letter on a coloured circle (folder-like square for groups)
    Label:
        size_hint: None, None
        size: dp(38), dp(38)
        pos_hint: {'center_y': 0.5}
        text: theme.initials(root.title)
        bold: True
        font_size: '16sp'
        color: 1, 1, 1, 1
        canvas.before:
            Color:
                rgba: theme.avatar(root.title)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12) if root.kind == 'group' else dp(19)]
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.title
            color: theme.TEXT
            font_size: '14sp'
            bold: root.kind == 'group' or root.selected
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            shorten: True
            shorten_from: 'right'
        Label:
            text: root.subtitle + ('' if root.has_pdf else ('  ·  no PDF' if root.subtitle else 'no PDF'))
            color: theme.MUTED if root.has_pdf else theme.WARN
            font_size: '12sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            shorten: True
            size_hint_y: None
            height: dp(18) if (root.subtitle or not root.has_pdf) else 0
            opacity: 1 if (root.subtitle or not root.has_pdf) else 0
    Label:
        text: root.count
        color: theme.ACCENT if not root.selected else theme.on(theme.ACCENT)
        bold: True
        font_size: '12sp'
        size_hint_x: None
        width: max(dp(34), self.texture_size[0] + dp(18)) if root.count else 0
        canvas.before:
            Color:
                rgba: (theme.ACCENT if root.selected else theme.ACCENT_CONTAINER) if root.count else (0, 0, 0, 0)
            RoundedRectangle:
                pos: self.x, self.center_y - dp(12)
                size: self.width, dp(24)
                radius: [dp(12)]

<CommentRow>:
    size_hint_y: None
    height: max(dp(40), lbl.texture_size[1] + dp(18))
    spacing: dp(8)
    padding: dp(14), 0, dp(6), 0
    canvas.before:
        Color:
            rgba: theme.ROW
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: theme.ACCENT
        RoundedRectangle:
            pos: self.x, self.y + dp(8)
            size: dp(3), max(0, self.height - dp(16))
            radius: [dp(1.5)]
    Label:
        id: lbl
        text: root.text
        color: theme.TEXT
        font_size: '14sp'
        text_size: self.width, None
        valign: 'middle'
    FlatButton:
        text: 'Remove'
        size_hint: None, None
        width: dp(80)
        height: dp(30)
        font_size: '12sp'
        pos_hint: {'center_y': 0.5}
        on_release: app.remove_comment(root.text)

# ---------------------------------------------------------------- main window
<SciLibraRoot@BoxLayout>:
    orientation: 'vertical'

    # app bar (gradient)
    BoxLayout:
        size_hint_y: None
        height: dp(68)
        padding: dp(16), dp(13)
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                texture: theme.gradient()
        canvas.after:
            Color:
                rgba: theme.SHADOW
            BoxShadow:
                pos: self.x, self.y - dp(1)
                size: self.width, dp(1)
                offset: 0, -dp(2)
                blur_radius: dp(8)
        Widget:
            size_hint: None, None
            size: dp(42), dp(42)
            pos_hint: {'center_y': 0.5}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.95
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 1, 1, 1, 1
                Ellipse:
                    pos: self.x + dp(3), self.y + dp(3)
                    size: self.width - dp(6), self.height - dp(6)
                    source: app.icon
        Label:
            text: '[b]SciLibra[/b]'
            markup: True
            color: theme.ON_BAR
            font_size: '21sp'
            size_hint_x: None
            width: dp(104)
        BarButton:
            text: 'Add'
            size_hint_x: None
            width: dp(68)
            on_release: app.open_menu(self, 'add')
        BarButton:
            text: 'Library'
            size_hint_x: None
            width: dp(84)
            on_release: app.open_menu(self, 'library')
        BarButton:
            text: 'Help'
            size_hint_x: None
            width: dp(64)
            on_release: app.open_menu(self, 'help')
        Widget:
        SearchInput:
            id: search
            hint_text: 'Search articles...  (Ctrl+F)'
            size_hint_x: None
            width: dp(340)
            pos_hint: {'center_y': 0.5}
            on_text_validate: app.search(self.text)
        FlatButton:
            text: 'Search'
            bold: True
            bg: theme.ON_BAR
            fg: theme.BAR_1
            size_hint_x: None
            width: dp(84)
            pos_hint: {'center_y': 0.5}
            on_release: app.search(search.text)
        BarButton:
            text: 'Options'
            size_hint_x: None
            width: dp(84)
            pos_hint: {'center_y': 0.5}
            on_release: app.search_options()
        DriveButton:
            on_release: app.drive.open_dialog() if app.drive else None

    # body
    BoxLayout:
        padding: dp(14)
        spacing: dp(14)

        # left: groups / articles
        Panel:
            orientation: 'vertical'
            size_hint_x: 0.42
            padding: dp(12)
            spacing: dp(10)
            BoxLayout:
                size_hint_y: None
                height: dp(38)
                spacing: dp(8)
                Label:
                    text: 'Group by'
                    color: theme.MUTED
                    size_hint_x: None
                    width: dp(70)
                DarkSpinner:
                    id: group_spinner
                    text: app.group_choice
                    values: app.group_choices
                    on_text: app.group_choice = self.text
            BoxLayout:
                size_hint_y: None
                height: dp(36)
                spacing: dp(8)
                FlatButton:
                    text: '\u2039  Back' if app.can_go_back else ''
                    size_hint_x: None
                    width: dp(76) if app.can_go_back else 0
                    opacity: 1 if app.can_go_back else 0
                    on_release: if app.can_go_back: app.go_back()
                Label:
                    text: app.breadcrumb
                    color: theme.TEXT
                    font_size: '17sp'
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                    shorten: True
            DarkInput:
                id: list_filter
                hint_text: 'Filter this list... (Ctrl+L)'
                on_text: app.apply_filter()
            RelativeLayout:
                RecycleView:
                    id: rv
                    viewclass: 'ListRow'
                    bar_width: dp(8)
                    scroll_type: ['bars', 'content']
                    RecycleBoxLayout:
                        default_size: None, dp(60)
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: 'vertical'
                        spacing: dp(6)
                        padding: 0, 0, dp(10), 0
                Label:
                    text: ('Your library is empty.\n\nUse [b]Add[/b] to import a BibTeX file,\npaste BibTeX, or add PDF files.' if (app.library and app.library.count() == 0 and not list_filter.text) else 'Nothing to show.') if app.list_count == 0 else ''
                    markup: True
                    halign: 'center'
                    color: theme.MUTED
                    text_size: self.width - dp(20), None
            Label:
                text: '{} {}'.format(app.list_count, 'item' if app.list_count == 1 else 'items')
                color: theme.MUTED
                font_size: '12sp'
                size_hint_y: None
                height: dp(16)
                text_size: self.size
                halign: 'right'

        # right: details
        Panel:
            orientation: 'vertical'
            padding: dp(6)
            ScrollView:
                id: details_scroll
                do_scroll_x: False
                bar_width: dp(8)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(20), dp(18)
                    spacing: dp(14)
                    TLabel:
                        text: '' if app.selected_key else 'Select an article on the left to see its details.\n\nTips: double-click (or Enter) opens the PDF, arrow keys move through the list, Esc goes back.'
                        color: theme.MUTED
                        height: 0 if app.selected_key else self.texture_size[1] + dp(40)
                        opacity: 0 if app.selected_key else 1
                        halign: 'center'
                        padding: 0, dp(40), 0, 0
                    BoxLayout:
                        size_hint_y: None
                        height: max(head.height, thumb.height) if app.selected_key else 0
                        opacity: 1 if app.selected_key else 0
                        spacing: dp(16)
                        BoxLayout:
                            id: head
                            orientation: 'vertical'
                            pos_hint: {'top': 1}
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(8)
                            TLabel:
                                text: '[b]' + app.d_title + '[/b]'
                                font_size: '22sp'
                            TLabel:
                                text: app.d_meta
                                color: theme.MUTED
                            TLabel:
                                text: app.d_pdf
                                font_size: '12sp'
                                color: theme.MUTED
                        Image:
                            id: thumb
                            texture: app.d_thumb
                            size_hint: None, None
                            size: (dp(170), dp(220)) if app.d_thumb else (0, 0)
                            pos_hint: {'top': 1}
                            fit_mode: 'contain'
                            canvas.before:
                                Color:
                                    rgba: theme.SHADOW if app.d_thumb else (0, 0, 0, 0)
                                BoxShadow:
                                    pos: self.center_x - self.norm_image_size[0] / 2, self.center_y - self.norm_image_size[1] / 2
                                    size: self.norm_image_size
                                    offset: 0, -dp(3)
                                    blur_radius: dp(12)
                    TLabel:
                        text: app.d_body
                        on_ref_press: app.on_ref(args[1])
                        height: (self.texture_size[1] if app.selected_key else 0)
                    Collapsible:
                        shown: app.d_has_pdf
                        size_hint_y: None
                        height: dp(30) if self.shown else 0
                        opacity: 1 if self.shown else 0
                        spacing: dp(8)
                        SectionLabel:
                            text: 'Highlights & notes in the PDF' + ('  ({})'.format(len(app.d_annotations)) if app.d_annotations else '')
                            size_hint_y: None
                            height: dp(30)
                            valign: 'middle'
                            text_size: self.size
                        FlatButton:
                            text: 'Save as comments'
                            size_hint: None, None
                            size: dp(150), dp(30) if app.d_annotations else 0
                            opacity: 1 if app.d_annotations else 0
                            disabled: not app.d_annotations
                            font_size: '12sp'
                            on_release: app.annotations_to_comments()
                    MutedLabel:
                        text: app.d_annotations_info if app.d_has_pdf else ''
                        height: self.texture_size[1] if (app.d_has_pdf and app.d_annotations_info) else 0
                    BoxLayout:
                        id: annotations_box
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)
                    SectionLabel:
                        text: 'Comments' if app.selected_key else ''
                        height: (self.texture_size[1] if app.selected_key else 0)
                    BoxLayout:
                        id: comments_box
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)
                    Collapsible:
                        shown: bool(app.selected_key)
                        size_hint_y: None
                        height: dp(38) if self.shown else 0
                        opacity: 1 if self.shown else 0
                        spacing: dp(8)
                        DarkInput:
                            id: comment_input
                            hint_text: 'Write a comment and press Enter...'
                            disabled: not app.selected_key
                            on_text_validate: app.add_comment(self.text)
                        FlatButton:
                            text: 'Add'
                            size_hint_x: None
                            width: dp(70)
                            disabled: not app.selected_key
                            on_release: app.add_comment(comment_input.text)
            BoxLayout:
                size_hint_y: None
                height: dp(58)
                padding: dp(12), dp(10)
                spacing: dp(8)
                canvas.before:
                    Color:
                        rgba: theme.OUTLINE
                    Rectangle:
                        pos: self.x + dp(12), self.top - dp(1)
                        size: self.width - dp(24), dp(1)
                AccentButton:
                    text: 'Open PDF'
                    disabled: not app.selected_key
                    on_release: app.open_pdf()
                FlatButton:
                    text: 'Attach PDF...'
                    disabled: not app.selected_key
                    on_release: app.attach_pdf()
                FlatButton:
                    text: 'Edit...'
                    disabled: not app.selected_key
                    on_release: app.edit_article()
                FlatButton:
                    text: 'Copy BibTeX'
                    disabled: not app.selected_key
                    on_release: app.copy_bibtex()
                FlatButton:
                    text: 'External'
                    disabled: not app.d_has_pdf
                    on_release: app.open_external()
                FlatButton:
                    text: 'Folder'
                    disabled: not app.d_has_pdf
                    on_release: app.open_folder()
                DangerButton:
                    text: 'Delete'
                    disabled: not app.selected_key
                    on_release: app.delete_article()

    # status bar
    BoxLayout:
        size_hint_y: None
        height: dp(28)
        padding: dp(18), 0, dp(18), dp(4)
        Label:
            text: app.status
            color: theme.TEXT
            font_size: '12sp'
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            shorten: True
        Label:
            text: app.library_info
            color: theme.MUTED
            font_size: '12sp'
            text_size: self.size
            halign: 'right'
            valign: 'middle'
            shorten: True
            shorten_from: 'left'

<DriveButton@HoverBehavior+ButtonBehavior+BoxLayout>:
    size_hint: None, None
    size: dp(154), dp(40)
    pos_hint: {'center_y': 0.5}
    padding: dp(12), 0
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: (theme.SUCCESS if app.drive_connected else (1, 1, 1, 0.18 if self.hovered else 0.1)) if self.state == 'normal' else (theme.darker(theme.SUCCESS, 0.08) if app.drive_connected else (1, 1, 1, 0.3))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: (1, 1, 1, 0) if app.drive_connected else (1, 1, 1, 0.45)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, self.height / 2
            width: dp(1)
    Icon:
        icon: 'cloud'
        color: 1, 1, 1, 1
        size_hint_x: None
        width: dp(26)
    Label:
        text: ('Syncing...' if app.drive_syncing else 'Drive: on') if app.drive_connected else 'Google Drive'
        color: 1, 1, 1, 1
        font_size: '14sp'
        bold: app.drive_connected
        text_size: self.size
        halign: 'left'
        valign: 'middle'

<DriveDialog>:
    size_hint: 0.7, 0.86
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        # --- not set up yet
        Collapsible:
            orientation: 'vertical'
            spacing: dp(10)
            shown: root.state == 'setup'
            size_hint_y: 1 if self.shown else None
            height: 0 if not self.shown else 100
            opacity: 1 if self.shown else 0
            TLabel:
                text: '[b]Back up your library and PDFs to Google Drive[/b]'
                font_size: '16sp'
            ScrollView:
                do_scroll_x: False
                TLabel:
                    text: root.setup_steps
                    markup: False
            BoxLayout:
                size_hint_y: None
                height: dp(38)
                spacing: dp(8)
                FlatButton:
                    text: 'Open Google Cloud Console'
                    on_release: root.controller.open_console()
                AccentButton:
                    text: 'Load client file...'
                    on_release: root.controller.load_client_file()
        # --- ready to sign in
        Collapsible:
            orientation: 'vertical'
            spacing: dp(14)
            shown: root.state == 'signin'
            size_hint_y: 1 if self.shown else None
            height: 0 if not self.shown else 100
            opacity: 1 if self.shown else 0
            TLabel:
                text: '[b]Connect SciLibra to your Google Drive[/b]'
                font_size: '16sp'
            TLabel:
                text: 'Sign in with your Google account to back up this library and all its PDFs (with your highlights and notes) to a "SciLibra" folder on your Google Drive, and to restore them on another computer.\n\nSciLibra can only access the files it creates - never your other Drive files.'
                color: theme.MUTED
            Widget:
            AccentButton:
                text: 'Sign in with Google'
                font_size: '16sp'
                height: dp(46)
                on_release: root.controller.sign_in()
            FlatButton:
                text: 'Use a different OAuth client file...'
                on_release: root.controller.load_client_file()
        # --- connected
        Collapsible:
            orientation: 'vertical'
            spacing: dp(12)
            shown: root.state == 'connected'
            size_hint_y: 1 if self.shown else None
            height: 0 if not self.shown else 100
            opacity: 1 if self.shown else 0
            BoxLayout:
                size_hint_y: None
                height: dp(44)
                spacing: dp(10)
                canvas.before:
                    Color:
                        rgba: theme.SUCCESS
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(14)]
                Icon:
                    icon: 'check'
                    color: 1, 1, 1, 1
                    size_hint_x: None
                    width: dp(40)
                Label:
                    text: 'Connected to Google Drive as ' + root.account
                    color: 1, 1, 1, 1
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
                    shorten: True
            TLabel:
                text: 'Last backup: [b]' + root.last_sync + '[/b]\nYour library and PDFs are in the "SciLibra" folder of your Google Drive.\nDrive keeps earlier versions of the library, plus one dated copy per day (last 10 days).'
                color: theme.MUTED
            BoxLayout:
                size_hint_y: None
                height: dp(34)
                CheckBox:
                    active: root.auto_sync
                    size_hint_x: None
                    width: dp(36)
                    on_active: root.controller.set_auto_sync(self.active); root.auto_sync = self.active
                Label:
                    text: 'Back up automatically after changes and when closing SciLibra'
                    color: theme.TEXT
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'
            Widget:
            AccentButton:
                text: 'Back up now'
                font_size: '15sp'
                height: dp(42)
                on_release: root.controller.sync(manual=True)
            BoxLayout:
                size_hint_y: None
                height: dp(38)
                spacing: dp(8)
                FlatButton:
                    text: 'Open in Google Drive'
                    on_release: root.controller.open_in_browser()
                FlatButton:
                    text: 'Restore from Drive...'
                    on_release: root.controller.restore()
                DangerButton:
                    text: 'Sign out'
                    on_release: root.controller.sign_out()
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            Widget:
            FlatButton:
                text: 'Close'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()

# ---------------------------------------------------------------- dialogs
<BasePopup>:
    title_size: '19sp'
    title_color: theme.TEXT
    separator_color: theme.OUTLINE
    separator_height: dp(1)
    background: theme.ROUNDED
    border: theme.ROUNDED_BORDER
    background_color: theme.PANEL
    overlay_color: 0.05, 0.03, 0.12, 0.45

<MessageDialog>:
    size_hint: 0.72, 0.72
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        ScrollView:
            do_scroll_x: False
            TLabel:
                text: root.message
                markup: False
                font_name: 'RobotoMono-Regular'
                font_size: '13sp'
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Widget:
            FlatButton:
                text: 'Copy text'
                size_hint_x: None
                width: dp(110)
                on_release: root.copy()
            AccentButton:
                text: 'Close'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()

<ConfirmDialog>:
    size_hint: 0.62, 0.6
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        ScrollView:
            do_scroll_x: False
            TLabel:
                text: root.message
                markup: False
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Widget:
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()
            FlatButton:
                text: root.confirm_text
                bg: theme.DANGER if root.danger else theme.ACCENT
                size_hint_x: None
                width: max(dp(110), self.texture_size[0] + dp(24))
                on_release: root.confirm()

<TextDialog>:
    size_hint: 0.8, 0.85
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        TLabel:
            text: root.info
            color: theme.MUTED
            height: self.texture_size[1] if root.info else 0
        DarkInput:
            id: input
            text: root.text
            hint_text: root.hint
            multiline: True
            size_hint_y: 1
            font_name: 'RobotoMono-Regular'
            font_size: '13sp'
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Widget:
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()
            AccentButton:
                text: root.confirm_text
                size_hint_x: None
                width: dp(110)
                on_release: root.confirm()

<ProgressDialog>:
    size_hint: 0.5, None
    height: dp(180)
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        Label:
            text: root.message
            color: theme.TEXT
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            shorten: True
        ThemedProgress:
            max: root.maximum
            value: root.value
        BoxLayout:
            size_hint_y: None
            height: dp(36)
            Widget:
            FlatButton:
                text: 'Cancelling...' if root.cancelled else 'Cancel'
                disabled: root.cancelled
                size_hint_x: None
                width: dp(120)
                on_release: root.cancelled = True

<FileDialog>:
    size_hint: 0.9, 0.9
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(6)
            FlatButton:
                text: 'Up'
                size_hint: None, None
                size: dp(56), dp(38)
                on_release: root.go_up()
            FlatButton:
                text: 'Home'
                size_hint: None, None
                size: dp(70), dp(38)
                on_release: root.go_to('~')
            DarkInput:
                id: path_input
                text: chooser.path
                on_text_validate: root.go_to(self.text)
        FileChooserListView:
            id: chooser
            path: root.path
            filters: root.filters
            multiselect: root.multiselect
            dirselect: root.mode == 'folder'
            on_submit: if root.mode == 'open': root.confirm()
            on_entry_added: widgets.style_file_entry(args[1])
            on_kv_post: widgets.style_file_chooser(self)
        Collapsible:
            shown: root.mode == 'save'
            size_hint_y: None
            height: dp(38) if self.shown else 0
            opacity: 1 if self.shown else 0
            spacing: dp(8)
            FieldLabel:
                text: 'File name'
            DarkInput:
                id: filename
                text: root.filename
                on_text_validate: root.confirm()
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Label:
                text: root.error or ('Folder: ' + chooser.path if root.mode == 'folder' else ('{} selected'.format(len(chooser.selection)) if root.mode == 'open' and chooser.selection else ''))
                color: theme.ERROR if root.error else theme.MUTED
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                shorten: True
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()
            AccentButton:
                text: root.confirm_text
                size_hint_x: None
                width: max(dp(110), self.texture_size[0] + dp(24))
                on_release: root.confirm()

<PickRow>:
    size_hint_y: None
    height: dp(34)
    spacing: dp(6)
    CheckBox:
        active: root.checked
        size_hint_x: None
        width: dp(34)
        on_release: root.toggle()
    Label:
        text: root.text
        color: theme.TEXT
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
    Label:
        text: str(root.count) if root.count else 'new'
        color: theme.MUTED
        font_size: '12sp'
        size_hint_x: None
        width: dp(40)

<ValuePicker>:
    size_hint: 0.55, 0.85
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        DarkInput:
            id: filter
            hint_text: 'Filter...'
            on_text: root.refresh()
        RecycleView:
            id: rv
            viewclass: 'PickRow'
            bar_width: dp(8)
            scroll_type: ['bars', 'content']
            RecycleBoxLayout:
                default_size: None, dp(34)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            DarkInput:
                id: new_value
                hint_text: 'New value(s), comma separated'
                on_text_validate: root.add_new(self.text)
            FlatButton:
                text: 'Add'
                size_hint_x: None
                width: dp(70)
                on_release: root.add_new(new_value.text)
        MutedLabel:
            text: '{} selected: {}'.format(len(root.selected), ', '.join(root.selected))
            shorten: True
            text_size: self.width, dp(18)
            height: dp(18)
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Widget:
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()
            AccentButton:
                text: 'Done'
                size_hint_x: None
                width: dp(110)
                on_release: root.done()

<ArticleEditor>:
    size_hint: 0.92, 0.94
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(8)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                padding: 0, 0, dp(12), 0
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    FieldLabel:
                        text: 'Type'
                    DarkSpinner:
                        id: entry_type
                        text: 'article'
                        values: ['article', 'inproceedings', 'book', 'incollection', 'inbook', 'phdthesis', 'mastersthesis', 'techreport', 'misc', 'unpublished', 'online']
                        size_hint_x: None
                        width: dp(170)
                    FieldLabel:
                        text: 'Key *'
                    DarkInput:
                        id: key
                        hint_text: 'e.g. smith2020deep (PDF name: <key>.pdf)'
                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    FieldLabel:
                        text: 'Title *'
                    DarkInput:
                        id: title
                        multiline: True
                        height: dp(64)
                BoxLayout:
                    size_hint_y: None
                    height: dp(100)
                    FieldLabel:
                        text: 'Authors'
                    DarkInput:
                        id: authors
                        multiline: True
                        height: dp(100)
                        hint_text: 'One author per line, e.g.\nSmith, John\nDoe, Jane'
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    FieldLabel:
                        text: 'Journal'
                    DarkInput:
                        id: journal
                        hint_text: 'Journal, conference or book title'
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    FieldLabel:
                        text: 'Year'
                    DarkInput:
                        id: year
                        input_filter: 'int'
                    FieldLabel:
                        text: 'Volume'
                    DarkInput:
                        id: volume
                    FieldLabel:
                        text: 'Number'
                    DarkInput:
                        id: number
                    FieldLabel:
                        text: 'Pages'
                    DarkInput:
                        id: pages
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    FieldLabel:
                        text: 'Publisher'
                    DarkInput:
                        id: publisher
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    FieldLabel:
                        text: 'DOI'
                    DarkInput:
                        id: doi
                        hint_text: 'e.g. 10.1371/journal.pone.0291204'
                    FlatButton:
                        text: 'Fetch details'
                        size_hint_x: None
                        width: dp(120)
                        on_release: root.fetch_doi()
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    FieldLabel:
                        text: 'URL'
                    DarkInput:
                        id: url
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    FieldLabel:
                        text: 'Keywords'
                    DarkInput:
                        id: keywords
                        hint_text: 'Comma separated'
                    FlatButton:
                        text: 'Pick...'
                        size_hint_x: None
                        width: dp(80)
                        on_release: root.pick('keywords')
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    FieldLabel:
                        text: 'Tag groups'
                    DarkInput:
                        id: taggroups
                        hint_text: 'Your own groups, comma separated (e.g. to-read, thesis)'
                    FlatButton:
                        text: 'Pick...'
                        size_hint_x: None
                        width: dp(80)
                        on_release: root.pick('taggroups')
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    FieldLabel:
                        text: 'PDF file'
                    DarkInput:
                        id: pdf
                        hint_text: 'Path of the PDF (optional)'
                    FlatButton:
                        text: 'Browse...'
                        size_hint_x: None
                        width: dp(80)
                        on_release: root.browse_pdf()
                BoxLayout:
                    size_hint_y: None
                    height: dp(150)
                    FieldLabel:
                        text: 'Abstract'
                    DarkInput:
                        id: abstract
                        multiline: True
                        height: dp(150)
        Label:
            text: root.error or root.status
            color: theme.ERROR if root.error else theme.MUTED
            size_hint_y: None
            height: dp(20)
            text_size: self.size
            halign: 'left'
            shorten: True
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            Widget:
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(110)
                on_release: root.dismiss()
            AccentButton:
                text: 'Save'
                size_hint_x: None
                width: dp(110)
                on_release: root.save()

# ---------------------------------------------------------------- PDF viewer
<PdfPage>:
    canvas.before:
        Color:
            rgba: theme.SHADOW
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -dp(3)
            blur_radius: dp(14)
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: self.texture

<AnnotationItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: max(dp(44), content.height + dp(14))
    spacing: dp(8)
    padding: 0, dp(7), dp(8), dp(7)
    canvas.before:
        Color:
            rgba: theme.darker(theme.ROW, 0.04) if self.state == 'down' else theme.ROW
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(4)]
        Color:
            rgba: root.swatch
        Rectangle:
            pos: self.x, self.y
            size: dp(5), self.height
    Widget:
        size_hint_x: None
        width: dp(4)
    BoxLayout:
        id: content
        orientation: 'vertical'
        size_hint_y: None
        height: head.texture_size[1] + text.texture_size[1] + dp(4)
        pos_hint: {'top': 1}
        Label:
            id: head
            text: root.heading
            color: theme.MUTED
            font_size: '12sp'
            bold: True
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
        Label:
            id: text
            text: root.body
            color: theme.TEXT
            font_size: '13sp'
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]

<TocItem>:
    size_hint_y: None
    height: max(dp(30), lbl.texture_size[1] + dp(10))
    padding: dp(8) + dp(14) * (root.level - 1), 0, dp(6), 0
    canvas.before:
        Color:
            rgba: theme.darker(theme.ROW, 0.04) if self.state == 'down' else (theme.ROW if root.level == 1 else theme.PANEL)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(3)]
    Label:
        id: lbl
        text: root.title
        color: theme.TEXT if root.level == 1 else theme.MUTED
        bold: root.level == 1
        font_size: '13sp'
        text_size: self.width, None
        valign: 'middle'
    Label:
        text: str(root.page)
        color: theme.MUTED
        font_size: '12sp'
        size_hint_x: None
        width: dp(34)

<ColorSwatch>:
    size_hint: None, None
    size: dp(26), dp(26)
    canvas:
        Color:
            rgba: (1, 1, 1, 1) if self.selected else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x - dp(2), self.y - dp(2)
            size: self.width + dp(4), self.height + dp(4)
            radius: [dp(6)]
        Color:
            rgba: list(self.rgb) + [1]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(5)]

<AnnotationEditor>:
    size_hint: 0.5, 0.6
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        MutedLabel:
            text: root.heading
        TLabel:
            text: ('\u201c' + root.marked_text + '\u201d') if root.marked_text else ''
            markup: False
            height: self.texture_size[1] if root.marked_text else 0
        DarkInput:
            id: note
            text: root.note
            hint_text: 'Your note (optional)'
            multiline: True
            size_hint_y: 1
        BoxLayout:
            id: swatches
            size_hint_y: None
            height: dp(34)
            spacing: dp(10)
            padding: dp(2), dp(4)
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            spacing: dp(8)
            DangerButton:
                text: 'Delete'
                size_hint_x: None
                width: dp(100)
                on_release: root.finish('delete')
            Widget:
            FlatButton:
                text: 'Cancel'
                size_hint_x: None
                width: dp(100)
                on_release: root.dismiss()
            AccentButton:
                text: 'Save'
                size_hint_x: None
                width: dp(100)
                on_release: root.finish('save')

<PdfViewer>:
    size_hint: 1, 1
    background: ''
    background_color: theme.BG
    overlay_color: 0, 0, 0, 0.6
    BoxLayout:
        orientation: 'vertical'
        # navigation bar
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(10), dp(7)
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: theme.PANEL
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.title
                color: theme.TEXT
                bold: True
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                shorten: True
            FlatButton:
                text: '<'
                size_hint_x: None
                width: dp(34)
                on_release: root.previous_page()
            DarkInput:
                id: page_input
                text: str(root.page)
                input_filter: 'int'
                halign: 'center'
                size_hint_x: None
                width: dp(54)
                height: dp(36)
                padding: dp(4), dp(8)
                on_text_validate: root.go_to(int(self.text or 1))
            Label:
                text: '/ {}'.format(root.page_count)
                color: theme.MUTED
                size_hint_x: None
                width: dp(44)
            FlatButton:
                text: '>'
                size_hint_x: None
                width: dp(34)
                on_release: root.next_page()
            FlatButton:
                text: '-'
                size_hint_x: None
                width: dp(34)
                on_release: root.zoom_out()
            Label:
                text: '{}%'.format(int(round(root.zoom * 100)))
                color: theme.TEXT
                size_hint_x: None
                width: dp(50)
            FlatButton:
                text: '+'
                size_hint_x: None
                width: dp(34)
                on_release: root.zoom_in()
            FlatButton:
                text: 'Fit'
                bg: theme.ACCENT if root.fit_width else theme.BUTTON
                size_hint_x: None
                width: dp(50)
                on_release: root.fit()
            DarkInput:
                id: search
                hint_text: 'Find in PDF (Ctrl+F)'
                size_hint_x: None
                width: dp(180)
                height: dp(36)
                padding: dp(8), dp(8)
                on_text_validate: root.search(self.text)
            FlatButton:
                text: '<'
                size_hint_x: None
                width: dp(30)
                disabled: root.hit_count == 0
                on_release: root.next_hit(-1)
            FlatButton:
                text: '>'
                size_hint_x: None
                width: dp(30)
                disabled: root.hit_count == 0
                on_release: root.next_hit(1)
            FlatButton:
                text: 'Night'
                bg: theme.ACCENT if root.night else theme.BUTTON
                size_hint_x: None
                width: dp(60)
                on_release: root.night = not root.night
            FlatButton:
                text: 'External'
                size_hint_x: None
                width: dp(78)
                on_release: root.open_external()
            Widget:
                size_hint_x: None
                width: dp(6)
            DangerButton:
                text: '\u00d7   Close'
                bg: theme.DANGER
                bold: True
                size_hint_x: None
                width: dp(96)
                on_release: root.dismiss()
        # annotation tools
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            padding: dp(10), dp(5)
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: theme.darker(theme.PANEL, 0.02)
                Rectangle:
                    pos: self.pos
                    size: self.size
            BoxLayout:
                id: tool_row
                size_hint_x: None
                width: self.minimum_width
                spacing: dp(3)
            Widget:
            FlatButton:
                text: 'Notes ({})'.format(len(root.annotations))
                bg: theme.ACCENT if root.panel == 'annotations' else theme.BUTTON
                size_hint: None, None
                size: dp(96), dp(32)
                pos_hint: {'center_y': 0.5}
                on_release: root.toggle_panel('annotations')
            FlatButton:
                text: 'Contents'
                bg: theme.ACCENT if root.panel == 'contents' else theme.BUTTON
                disabled: not root.toc
                size_hint: None, None
                size: dp(86), dp(32)
                pos_hint: {'center_y': 0.5}
                on_release: root.toggle_panel('contents')
        # text selection actions
        Collapsible:
            shown: bool(root.selection_text)
            size_hint_y: None
            height: dp(40) if self.shown else 0
            opacity: 1 if self.shown else 0
            padding: dp(10), dp(4)
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: theme.ACCENT_CONTAINER
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: '\u201c' + root.selection_text + '\u201d'
                color: theme.TEXT
                font_size: '13sp'
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                shorten: True
            FlatButton:
                text: 'Copy'
                size_hint: None, None
                size: dp(60), dp(30)
                on_release: root.copy_selection()
            FlatButton:
                text: 'Copy + citation'
                size_hint: None, None
                size: dp(124), dp(30)
                on_release: root.copy_selection(True)
            FlatButton:
                text: 'Highlight'
                size_hint: None, None
                size: dp(84), dp(30)
                on_release: root.markup_selection('Highlight')
            FlatButton:
                text: 'Underline'
                size_hint: None, None
                size: dp(84), dp(30)
                on_release: root.markup_selection('Underline')
            FlatButton:
                text: 'Save as comment'
                size_hint: None, None
                size: dp(128), dp(30)
                on_release: root.selection_to_comment()
            FlatButton:
                text: 'x'
                size_hint: None, None
                size: dp(30), dp(30)
                on_release: root.clear_selection()
        BoxLayout:
            ScrollView:
                id: scroll
                bar_width: dp(10)
                scroll_type: ['bars', 'content']
                scroll_wheel_distance: dp(60)
                BoxLayout:
                    id: pages
                    orientation: 'vertical'
                    size_hint: None, None
                    width: max(self.minimum_width, scroll.width)
                    height: self.minimum_height
                    padding: dp(20)
                    spacing: dp(14)
            Collapsible:
                shown: bool(root.panel)
                orientation: 'vertical'
                size_hint_x: None
                width: dp(330) if self.shown else 0
                opacity: 1 if self.shown else 0
                padding: dp(10)
                spacing: dp(8)
                canvas.before:
                    Color:
                        rgba: theme.PANEL
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: ('Notes & highlights' if root.annotations else 'No annotations yet - use the tools above to highlight, add notes or draw.') if root.panel == 'annotations' else 'Contents'
                    color: theme.TEXT
                    bold: True
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(6)
                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(6)
                    size_hint_y: 1 if root.panel == 'annotations' else None
                    height: 0 if root.panel != 'annotations' else self.height
                    opacity: 1 if root.panel == 'annotations' else 0
                    BoxLayout:
                        id: annotation_list
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(4)
                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(6)
                    size_hint_y: 1 if root.panel == 'contents' else None
                    height: 0 if root.panel != 'contents' else self.height
                    opacity: 1 if root.panel == 'contents' else 0
                    BoxLayout:
                        id: toc_list
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                BoxLayout:
                    size_hint_y: None
                    height: dp(36) if root.panel == 'annotations' else 0
                    opacity: 1 if root.panel == 'annotations' else 0
                    spacing: dp(6)
                    FlatButton:
                        text: 'Save as comments'
                        font_size: '13sp'
                        disabled: not root.annotations or root.panel != 'annotations'
                        on_release: root.save_all_as_comments()
                    FlatButton:
                        text: 'Export notes...'
                        font_size: '13sp'
                        disabled: root.panel != 'annotations'
                        on_release: root.export_notes()
        BoxLayout:
            size_hint_y: None
            height: dp(24)
            padding: dp(12), 0
            canvas.before:
                Color:
                    rgba: theme.PANEL
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.error or root.status or 'PgUp/PgDn: pages  ·  Ctrl+wheel or +/-: zoom  ·  Ctrl+F: find  ·  hover a tool to see its name and shortcut  ·  Ctrl+Z: undo  ·  Esc or Close: back to the library'
                color: theme.ERROR if root.error else theme.MUTED
                font_size: '12sp'
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                shorten: True
            Label:
                text: 'All changes saved in the PDF' if root.modified else 'Changes are saved automatically'
                color: theme.SUCCESS if root.modified else theme.MUTED
                font_size: '12sp'
                size_hint_x: None
                width: dp(230)
                text_size: self.size
                halign: 'right'
                valign: 'middle'
